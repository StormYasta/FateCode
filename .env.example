# Environment variables for FateCode

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
# The Docker container listens on 5432 internally and is exposed as 5433 on the host
# to avoid collisions with a PostgreSQL installation already running on Windows.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/fatecode?schema=public

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=supersecret_fatecode_jwt_key_development_only_2026!
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend URL
VITE_API_URL=http://localhost:3001/api
