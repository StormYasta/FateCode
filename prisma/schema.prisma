generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  ADMIN
  PROFESSOR
  STUDENT
}

enum ClassRole {
  STUDENT
  PROFESSOR
  ASSISTANT
}

enum ChallengeSource {
  INTERNAL
  CODEWARS
}

enum Difficulty {
  KYU_8
  KYU_7
  KYU_6
  KYU_5
  KYU_4
  KYU_3
  KYU_2
  KYU_1
}

enum AcademicSubject {
  DISCRETE_MATHEMATICS
  PROGRAMMING_LOGIC
  CALCULUS
  STATISTICS
  OPERATIONS_RESEARCH
  OTHER
}

enum AcademicExerciseType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  NUMERIC
  SHORT_TEXT
}

enum AcademicDifficulty {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum Language {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  JAVA
  C
  CPP
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  COMPILATION_ERROR
}

enum SolutionVisibility {
  PUBLIC
  ANONYMIZED
  PRIVATE
}

enum RankingPeriod {
  ALL_TIME
  SEASON
  MONTHLY
  WEEKLY
  DAILY
}

enum IntegrityRisk {
  NORMAL
  ATTENTION
  HIGH
}

enum DevelopmentEventType {
  SESSION_STARTED
  CODE_CHANGED
  CODE_SAVED
  CODE_EXECUTED
  TEST_FAILED
  TEST_PASSED
  CODE_SUBMITTED
  SESSION_ENDED
}

// --------------------------------------------------------
// AUTHENTICATION & USERS
// --------------------------------------------------------

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(STUDENT)
  avatarUrl    String?
  bio          String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile             Profile?
  classMemberships    ClassMember[]
  submissions         Submission[]
  academicSubmissions AcademicSubmission[]
  executions          Execution[]
  codeSnapshots       CodeSnapshot[]
  developmentEvents   DevelopmentEvent[]
  xpTransactions      XPTransaction[]
  rankings            Ranking[]
  streak              Streak?
  achievements        UserAchievement[]
  comments            Comment[]
  commentReports      CommentReport[]
  reportedComments    CommentReport[]   @relation("ReporterRelation")

  @@index([email])
  @@index([role])
}

model Profile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUsername     String?
  codewarsUsername   String?
  preferredLanguage  Language           @default(JAVASCRIPT)
  solutionVisibility SolutionVisibility @default(PUBLIC)
  totalXP            Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// --------------------------------------------------------
// ACADEMIC HIERARCHY
// --------------------------------------------------------

model Faculty {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses  Course[]
  rankings Ranking[]

  @@index([code])
}

model Course {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?
  facultyId   String
  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes       Class[]
  learningPaths LearningPath[]
  rankings      Ranking[]

  @@unique([facultyId, code])
  @@index([facultyId])
}

model Class {
  id        String   @id @default(uuid())
  name      String
  code      String
  semester  String
  year      Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             ClassMember[]
  assignments         Assignment[]
  academicAssignments AcademicAssignment[]
  rankings            Ranking[]

  @@unique([courseId, code])
  @@index([courseId])
}

model ClassMember {
  id       String    @id @default(uuid())
  classId  String
  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ClassRole @default(STUDENT)
  joinedAt DateTime  @default(now())

  @@unique([classId, userId])
  @@index([classId])
  @@index([userId])
}

// --------------------------------------------------------
// PEDAGOGICAL STRUCTURE
// --------------------------------------------------------

model LearningPath {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules Module[]
}

model Module {
  id             String       @id @default(uuid())
  title          String
  description    String?
  order          Int          @default(0)
  learningPathId String
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  topics Topic[]

  @@index([learningPathId])
}

model Topic {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int      @default(0)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenges Challenge[]

  @@index([moduleId])
}

// --------------------------------------------------------
// PROGRAMMING MODULE
// --------------------------------------------------------

model Challenge {
  id           String          @id @default(uuid())
  title        String
  slug         String          @unique
  description  String          @db.Text
  difficulty   Difficulty      @default(KYU_8)
  source       ChallengeSource @default(INTERNAL)
  externalId   String?
  language     Language        @default(JAVASCRIPT)
  initialCode  String          @db.Text
  testCode     String          @db.Text
  publicTests  Json
  hiddenTests  Json
  tags         String[]
  xpReward     Int             @default(50)
  isDaily      Boolean         @default(false)
  topicId      String?
  topic        Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  assignments       Assignment[]
  dailyChallenges   DailyChallenge[]
  submissions       Submission[]
  executions        Execution[]
  codeSnapshots     CodeSnapshot[]
  developmentEvents DevelopmentEvent[]
  comments          Comment[]

  @@index([externalId])
  @@index([difficulty])
  @@index([source])
}

model Assignment {
  id          String    @id @default(uuid())
  title       String
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  startDate   DateTime  @default(now())
  dueDate     DateTime?
  isOptional  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions Submission[]

  @@index([classId])
  @@index([challengeId])
}

model DailyChallenge {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  activeDate  DateTime  @unique @db.Date
  extraXp     Int       @default(100)
  createdAt   DateTime  @default(now())

  @@index([activeDate])
}

// --------------------------------------------------------
// DISCRETE MATHEMATICS / COMPLEMENTARY ACADEMIC MODULE
// --------------------------------------------------------

model AcademicExercise {
  id               String               @id @default(uuid())
  title            String
  slug             String               @unique
  statement        String               @db.Text
  subject          AcademicSubject
  exerciseType     AcademicExerciseType
  difficulty       AcademicDifficulty   @default(BASIC)
  options          Json?
  correctAnswer    Json
  explanation      String?              @db.Text
  numericTolerance Float?
  tags             String[]
  xpReward         Int                  @default(30)
  isPublished      Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  assignments AcademicAssignment[]
  submissions AcademicSubmission[]

  @@index([subject])
  @@index([exerciseType])
  @@index([difficulty])
  @@index([isPublished])
}

model AcademicAssignment {
  id         String           @id @default(uuid())
  title      String
  classId    String
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   AcademicExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  startDate  DateTime         @default(now())
  dueDate    DateTime?
  isOptional Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  submissions AcademicSubmission[]

  @@index([classId])
  @@index([exerciseId])
}

model AcademicSubmission {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     AcademicExercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   AcademicAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  answer       Json
  isCorrect    Boolean
  score        Float              @default(0)
  xpEarned     Int                @default(0)
  submittedAt  DateTime           @default(now())

  @@index([userId])
  @@index([exerciseId])
  @@index([assignmentId])
  @@index([isCorrect])
}

// --------------------------------------------------------
// PROGRAMMING EXECUTION & SUBMISSIONS
// --------------------------------------------------------

model Submission {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId     String
  challenge       Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  assignmentId    String?
  assignment      Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  code            String           @db.Text
  language        Language         @default(JAVASCRIPT)
  status          SubmissionStatus @default(PENDING)
  passedTests     Int              @default(0)
  totalTests      Int              @default(0)
  executionTimeMs Int?
  memoryUsedMb    Float?
  xpEarned        Int              @default(0)
  attemptCount    Int              @default(1)
  submittedAt     DateTime         @default(now())

  integrityAnalysis    IntegrityAnalysis?
  similaritiesAsSource CodeSimilarity[] @relation("SimilaritySource")
  similaritiesAsTarget CodeSimilarity[] @relation("SimilarityTarget")

  @@index([userId])
  @@index([challengeId])
  @@index([status])
}

model Execution {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId     String
  challenge       Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  code            String           @db.Text
  language        Language         @default(JAVASCRIPT)
  status          SubmissionStatus @default(PENDING)
  stdout          String?          @db.Text
  stderr          String?          @db.Text
  passedTests     Int              @default(0)
  totalTests      Int              @default(0)
  executionTimeMs Int?
  memoryUsedMb    Float?
  executedAt      DateTime         @default(now())

  @@index([userId])
  @@index([challengeId])
}

model CodeSnapshot {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  code        String    @db.Text
  language    Language  @default(JAVASCRIPT)
  charCount   Int
  lineCount   Int
  createdAt   DateTime  @default(now())

  @@index([userId, challengeId])
}

model DevelopmentEvent {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  eventType   DevelopmentEventType
  metadata    Json?
  timestamp   DateTime             @default(now())

  @@index([userId, challengeId])
  @@index([eventType])
}

// --------------------------------------------------------
// GAMIFICATION & SOCIAL
// --------------------------------------------------------

model XPTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([referenceId])
}

model Streak {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak    Int       @default(0)
  maxStreak        Int       @default(0)
  lastActivityDate DateTime? @db.Date
  updatedAt        DateTime  @updatedAt
}

model Season {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rankings Ranking[]
}

model Ranking {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId  String?
  faculty    Faculty?      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classId    String?
  class      Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  seasonId   String?
  season     Season?       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  period     RankingPeriod @default(ALL_TIME)
  xp         Int           @default(0)
  position   Int           @default(0)
  updatedAt  DateTime      @updatedAt

  @@unique([userId, period, facultyId, courseId, classId, seasonId])
  @@index([period, xp])
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  icon        String
  xpReward    Int      @default(100)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model Comment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")
  content     String    @db.Text
  isPinned    Boolean   @default(false)
  isHidden    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reports CommentReport[]

  @@index([challengeId])
  @@index([userId])
}

model CommentReport {
  id         String   @id @default(uuid())
  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([commentId])
  @@index([reporterId])
}

// --------------------------------------------------------
// ACADEMIC INTEGRITY & CODE SIMILARITY
// --------------------------------------------------------

model IntegrityAnalysis {
  id                String        @id @default(uuid())
  submissionId      String        @unique
  submission        Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  riskLevel         IntegrityRisk @default(NORMAL)
  anomalyIndicators Json
  similarityScore   Float?
  analysisReport    String?       @db.Text
  analyzedAt        DateTime      @default(now())
}

model CodeSimilarity {
  id                String     @id @default(uuid())
  submissionAId     String
  submissionA       Submission @relation("SimilaritySource", fields: [submissionAId], references: [id], onDelete: Cascade)
  submissionBId     String
  submissionB       Submission @relation("SimilarityTarget", fields: [submissionBId], references: [id], onDelete: Cascade)
  astSimilarity     Float
  tokenSimilarity   Float
  textSimilarity    Float
  overallSimilarity Float
  comparedAt        DateTime   @default(now())

  @@unique([submissionAId, submissionBId])
  @@index([submissionAId])
  @@index([submissionBId])
}
